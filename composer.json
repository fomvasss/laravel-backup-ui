{
    "name": "fomvasss/laravel-backup-ui",
    "description": "Web interface for spatie/laravel-backup package",
    "type": "library",
    "license": "MIT",
    "funding": [
        {
            "type": "custom",
            "url": "https://send.monobank.ua/jar/5xsqtHvVrY"
        },
        {
            "type": "ko_fi",
            "url": "https://ko-fi.com/fomvasss"
        }
    ],
    "authors": [
        {
            "name": "fomvasss",
            "email": "your-email@example.com"
        }
    ],
    "require": {
        "php": "^8.0",
        "laravel/framework": "^9|^10|^11|^12|^13",
        "spatie/laravel-backup": "^8|^9"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5|^10|^11",
        "orchestra/testbench": "^7|^8|^9|^10",
        "mockery/mockery": "^1.5"
    },
    "autoload": {
        "psr-4": {
            "Fomvasss\\LaravelBackupUi\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Fomvasss\\LaravelBackupUi\\BackupUiServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test-coverage": "vendor/bin/phpunit --coverage-html build/coverage",
        "test-unit": "vendor/bin/phpunit --testsuite=Unit",
        "test-feature": "vendor/bin/phpunit --testsuite=Feature"
    }
}
